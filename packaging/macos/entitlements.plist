<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The hardened runtime (required for notarization) blocks microphone access unless it is
       declared here. Without this entitlement calls would connect but stay silent. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
